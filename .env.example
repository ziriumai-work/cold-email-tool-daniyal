# ===========================================================================
# Cold Email Tool — environment variables
# Local dev: copy values into .env.local
# Vercel: add each of these in Project → Settings → Environment Variables
# ===========================================================================

# ---- Supabase PostgreSQL Database ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=


# ---- Team access (shared password) ----
# Set APP_PASSWORD to require login. SESSION_SECRET = any long random string.
APP_PASSWORD=
SESSION_SECRET=change-me-to-a-long-random-string
APP_BASE_URL=

# ---- Vercel Cron protection (scheduled sends + reply checks) ----
# Any random string. Vercel automatically sends it as a Bearer token to crons.
CRON_SECRET=change-me-to-another-random-string

# ---- Spacemail SMTP (sending) ----
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@yourcompany.com
SMTP_PASS=your-mailbox-password
FROM_NAME=Your Name
FROM_EMAIL=you@yourcompany.com
TEST_TO=your-personal@gmail.com

# Optional: multiple sender accounts for the UI sender dropdown.
# Put this on one line in .env.local, with real mailbox passwords.
# If this is empty, the app uses the single SMTP_USER/SMTP_PASS above.
# SENDER_ACCOUNTS=[{"key":"info","name":"Zirium AI","email":"info@ziriumai.com","smtpUser":"info@ziriumai.com","smtpPass":"password"},{"key":"wahaj","name":"Wahaj","email":"wahaj.s@ziriumai.com","smtpUser":"wahaj.s@ziriumai.com","smtpPass":"password"}]

# ---- Spacemail IMAP (reading replies; same mailbox login) ----
IMAP_HOST=mail.spacemail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# ---- DeepSeek ----
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- Email signature logo (production) ----
# After your first Vercel deploy, set this to your live logo URL so the
# signature logo renders (e.g. https://your-app.vercel.app/logo.png).
LOGO_URL=
